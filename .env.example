# API base URL (Expo inlines EXPO_PUBLIC_* at build time).
# Web: http://localhost:4000 works out of the box.
# iPhone on the same Wi-Fi: use your computer's LAN IP, e.g. http://192.168.0.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Demo mode: true = the app never touches the network (local fake data,
# see src/lib/mock-api.ts). Set false to talk to the real API.
EXPO_PUBLIC_USE_MOCK_API=false