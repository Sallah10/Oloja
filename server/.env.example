# Copy this file to .env and fill in your real values.
PORT=4000

# Neon gives you TWO urls. Keep them in the right slots or migrations will break.
# This one ends with a "-pooler" host and is used by the running app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-west-1.aws.neon.tech/oloja?sslmode=require"

# This one is the plain host (no "-pooler") and is used by prisma migrate / studio.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-west-1.aws.neon.tech/oloja?sslmode=require"