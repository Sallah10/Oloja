# Copy this file to .env and fill in your real values.
PORT=4000

# Neon gives you TWO urls. Keep them in the right slots or migrations will break.
# This one ends with a "-pooler" host and is used by the running app.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-west-1.aws.neon.tech/oloja?sslmode=require"

# This one is the plain host (no "-pooler") and is used by prisma migrate / studio.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-west-1.aws.neon.tech/oloja?sslmode=require"

# Only if the server sends push notifications: expo.dev -> Access tokens.
EXPO_ACCESS_TOKEN=exp_your_token_here

# Optional. Only used to REWORD the weekly letter (POST /api/whisper/letter) - the
# numbers are always computed by the app from the ledger, and the server refuses
# any reply containing a figure we did not send. Without a key the app writes the
# same letter locally and nothing is lost. Get one free at aistudio.google.com.
GEMINI_API_KEY=your_gemini_key_here

# Which Gemini model writes the letter (optional).
# gemini-2.5-flash is no longer available to new API keys.
GEMINI_MODEL=gemini-3.8-flash

# Set to true to see why a letter was refused (quota, grounding, truncation).
AI_DEBUG=false